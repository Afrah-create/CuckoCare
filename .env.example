# Copy to .env and fill in (never commit .env).
# Flutter reads env/dev.json — run: dart run tool/sync_env.dart

# Supabase project (Dashboard → Project Settings → API)
# Project URL only (Dashboard → API → Project URL), not /rest/v1
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — Supabase CLI, Edge Functions, CI (never ship in the app)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: linked remote for `supabase link`
SUPABASE_PROJECT_REF=your_project_ref_here

# Edge function secrets (Dashboard → Edge Functions → Secrets, never in the app)
# MAKYPAY_API_KEY=
# MAKYPAY_WEBHOOK_SECRET=
# MAKYREACH_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=CucoCare
# OTP_PEPPER=

ENV_NAME=dev
